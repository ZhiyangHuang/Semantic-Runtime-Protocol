{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "srp_experiment/schemas/semantic_runtime_graph_schema_v1.json",
  "title": "SRP Semantic Runtime Graph Schema v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "root_id",
    "nodes",
    "edges",
    "lifecycle",
    "summary"
  ],
  "$defs": {
    "number_or_null": {
      "type": [
        "number",
        "null"
      ]
    },
    "integer_or_null": {
      "type": [
        "integer",
        "null"
      ]
    },
    "string_or_null": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_graph_node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "label",
        "lifecycle"
      ],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "label": {"type": "string"},
        "importance": {"$ref": "#/$defs/number_or_null"},
        "confidence": {"$ref": "#/$defs/number_or_null"},
        "attributes": {"type": "object"},
        "lifecycle": {"type": "object"}
      }
    },
    "semantic_graph_edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "edge_id",
        "source",
        "target",
        "relation",
        "lifecycle"
      ],
      "properties": {
        "edge_id": {"type": "string"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "relation": {"type": "string"},
        "strength": {"$ref": "#/$defs/number_or_null"},
        "confidence": {"$ref": "#/$defs/number_or_null"},
        "evidence_pointer": {"$ref": "#/$defs/string_or_null"},
        "attributes": {"type": "object"},
        "lifecycle": {"type": "object"}
      }
    },
    "semantic_graph_lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "created_count",
        "compressed_count",
        "recovered_count",
        "verified_count",
        "retained_count",
        "object_survival_rate",
        "dependency_recall",
        "constraint_accuracy",
        "hallucination_rate",
        "graph_integrity_score"
      ],
      "properties": {
        "schema_version": {
          "const": "semantic_runtime_graph_lifecycle.v1"
        },
        "created_count": {"type": "integer"},
        "compressed_count": {"type": "integer"},
        "recovered_count": {"type": "integer"},
        "verified_count": {"type": "integer"},
        "retained_count": {"type": "integer"},
        "object_survival_rate": {"$ref": "#/$defs/number_or_null"},
        "dependency_recall": {"$ref": "#/$defs/number_or_null"},
        "constraint_accuracy": {"$ref": "#/$defs/number_or_null"},
        "hallucination_rate": {"$ref": "#/$defs/number_or_null"},
        "graph_integrity_score": {"$ref": "#/$defs/number_or_null"},
        "issues": {"type": "object"}
      }
    },
    "semantic_graph_validation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "source_node_count",
        "recovered_node_count",
        "retained_node_count",
        "missing_node_count",
        "hallucinated_node_count",
        "dependency_edge_count",
        "missing_dependency_count",
        "constraint_node_count",
        "constraint_violation_count",
        "object_survival_rate",
        "dependency_recall",
        "constraint_accuracy",
        "hallucination_rate",
        "graph_integrity_score"
      ],
      "properties": {
        "schema_version": {
          "const": "semantic_graph_validation.v1"
        },
        "source_node_count": {"type": "integer"},
        "recovered_node_count": {"type": "integer"},
        "retained_node_count": {"type": "integer"},
        "missing_node_count": {"type": "integer"},
        "hallucinated_node_count": {"type": "integer"},
        "dependency_edge_count": {"type": "integer"},
        "missing_dependency_count": {"type": "integer"},
        "constraint_node_count": {"type": "integer"},
        "constraint_violation_count": {"type": "integer"},
        "object_survival_rate": {"$ref": "#/$defs/number_or_null"},
        "dependency_recall": {"$ref": "#/$defs/number_or_null"},
        "constraint_accuracy": {"$ref": "#/$defs/number_or_null"},
        "hallucination_rate": {"$ref": "#/$defs/number_or_null"},
        "graph_integrity_score": {"$ref": "#/$defs/number_or_null"},
        "issues": {"type": "object"}
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "semantic_runtime_graph.v1"
    },
    "root_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_graph_node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_graph_edge"
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/semantic_graph_lifecycle"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "node_count",
        "edge_count",
        "validation"
      ],
      "properties": {
        "source_object_count": {"$ref": "#/$defs/integer_or_null"},
        "recovered_object_count": {"$ref": "#/$defs/integer_or_null"},
        "contract_object_count": {"$ref": "#/$defs/integer_or_null"},
        "node_count": {"type": "integer"},
        "edge_count": {"type": "integer"},
        "validation": {"$ref": "#/$defs/semantic_graph_validation"}
      }
    }
  }
}
