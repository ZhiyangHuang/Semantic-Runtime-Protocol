# Phase III-A constrained optimization configuration.
# This file freezes the optimization experiment settings for bounded candidate search.

SRP_PHASE=phase_iii_a
OPTIMIZATION_MODE=grid_search
PARAMETER_AXES=activation_threshold,recovery_min_evidence
ACTIVATION_THRESHOLD_VALUES=0.3,0.4,0.5,0.6,0.7,0.8
RECOVERY_MIN_EVIDENCE_VALUES=1,2,3
OBJECTIVE_SEMANTIC_WEIGHT=0.4
OBJECTIVE_RECOVERY_WEIGHT=0.3
OBJECTIVE_RESOURCE_WEIGHT=0.2
OBJECTIVE_STABILITY_WEIGHT=0.1
RANKING_ENABLED=true
GOVERNANCE_APPROVAL_REQUIRED=true
RUNTIME_MUTATION_ALLOWED=false
