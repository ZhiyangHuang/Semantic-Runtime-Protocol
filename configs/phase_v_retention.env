# Phase V semantic retention and drift evaluation configuration.
# This file freezes the baseline protocol for meaning-level fidelity measurement.

SRP_PHASE=phase_v_retention
EVALUATION_MODE=retention_drift
PARAMETER_AXES=activation_threshold,recovery_min_evidence,preserve_evidence,archive_relations
ACTIVATION_THRESHOLD_VALUES=0.1,0.3,0.5,0.7,0.9
RECOVERY_MIN_EVIDENCE_VALUES=1,2,3
PRESERVE_EVIDENCE_VALUES=false,true
ARCHIVE_RELATIONS_VALUES=false,true
BASELINE_ACTIVATION_THRESHOLD=0.5
BASELINE_RECOVERY_MIN_EVIDENCE=1
BASELINE_PRESERVE_EVIDENCE=false
BASELINE_ARCHIVE_RELATIONS=false
SEMANTIC_DRIFT_WEIGHTS=0.45,0.45,0.10
