\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparison between Semantic Runtime Protocol (SRP) and the strongest non-SRP baseline for each backend, model, and cycle setting. The baseline is selected by task success, then semantic drift, then token cost. $\Delta $ denotes SRP minus the selected baseline. Lower drift, token cost, and latency are better, while higher task success is better. Bold indicates the stronger value within each SRP-baseline pair.}}{2}{table.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:srp-camera-ready-table}{{1}{2}{Comparison between Semantic Runtime Protocol (SRP) and the strongest non-SRP baseline for each backend, model, and cycle setting. The baseline is selected by task success, then semantic drift, then token cost. $\Delta $ denotes SRP minus the selected baseline. Lower drift, token cost, and latency are better, while higher task success is better. Bold indicates the stronger value within each SRP-baseline pair}{table.caption.3}{}}
