{
  "description": "OpenAI API sweep for SRP experiments.",
  "shared": {
    "backend": "openai",
    "output_root": "srp_experiment/results/batch_runs/openai"
  },
  "runs": [
    {
      "name": "openai_core_methods",
      "cycles": [3, 5, 7],
      "models": ["gpt-4o-mini", "gpt-4.1-mini"],
      "methods": [
        ["raw_prompt", "summarization", "rag", "srp"]
      ]
    },
    {
      "name": "openai_srp_ablation",
      "cycles": [5, 9],
      "models": ["gpt-4o-mini"],
      "methods": [
        ["summarization", "srp"],
        ["rag", "srp"]
      ]
    }
  ]
}
