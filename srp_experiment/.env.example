# Copy this file to `srp_experiment/.env` and fill in the values you want to use.
# These defaults align with the frozen LongBench v2 evaluation plan.
# Command-line arguments still override these values when provided.

# Core runtime
SRP_BACKEND=local
SRP_MODEL=Qwen/Qwen3-4B-AWQ
SRP_TIMEOUT_SECONDS=120
SRP_MODEL_CONTEXT_BUDGET=1024
SRP_TOTAL_TOKEN_BUDGET=1024
SRP_SYSTEM_TOKEN_BUDGET=150
SRP_OUTPUT_TOKEN_BUDGET=120
SRP_QUERY_TOKEN_BUDGET=64
SRP_SAFETY_MARGIN_TOKENS=32
SRP_RAG_CHUNK_TOKENS=256
SRP_RAG_TOP_K=4

# Single-run defaults
SRP_CYCLES=100
SRP_METHODS=raw_prompt,summarization,rag,srp,rag_srp_v2
SRP_MAX_CYCLE_DRIFT=0.35
SRP_MIN_KEYWORD_SCORE=0.50
SRP_OUTPUT_DIR=srp_experiment/results

# Batch-run defaults
SRP_BATCH_CONFIG=srp_experiment/configs/longbench_v2_multimodel_100_1000.json
SRP_BATCH_RUNS_DIR=srp_experiment/results/batch_runs/longbench_v2_multimodel_100_1000
SRP_BATCH_MANIFEST_PATH=srp_experiment/results/batch_runs/longbench_v2_multimodel_100_1000/batch_manifest.json
SRP_BATCH_SUMMARY=srp_experiment/results/batch_summary_table.json

# Paper/evidence outputs
SRP_PAPER_TABLE_INPUT=srp_experiment/results/batch_summary_table.json
SRP_PAPER_TABLE_MD=srp_experiment/results/paper_table.md
SRP_PAPER_TABLE_TEX=srp_experiment/results/paper_table.tex
SRP_QUALITY_TABLE_MD=srp_experiment/results/quality_table.md
SRP_QUALITY_TABLE_TEX=srp_experiment/results/quality_table.tex
SRP_EFFICIENCY_TABLE_MD=srp_experiment/results/efficiency_table.md
SRP_EFFICIENCY_TABLE_TEX=srp_experiment/results/efficiency_table.tex
SRP_TOKEN_BREAKDOWN_MD=srp_experiment/results/token_breakdown_table.md
SRP_TOKEN_BREAKDOWN_TEX=srp_experiment/results/token_breakdown_table.tex
SRP_GUARDRAIL_TABLE_MD=srp_experiment/results/guardrail_table.md
SRP_GUARDRAIL_TABLE_TEX=srp_experiment/results/guardrail_table.tex
SRP_CAMERA_READY_MD=srp_experiment/results/camera_ready_table.md
SRP_CAMERA_READY_TEX=srp_experiment/results/camera_ready_table.tex
SRP_EVIDENCE_OUTPUT_DIR=srp_experiment/results/evidence_pipeline
SRP_EVIDENCE_MANIFEST=srp_experiment/results/evidence_pipeline/evidence_manifest.json
SRP_EVIDENCE_TRACE_LOG=srp_experiment/results/evidence_pipeline/execution_trace_log.json
SRP_EVIDENCE_TRACE_TABLE=srp_experiment/results/evidence_pipeline/execution_trace_table.json
SRP_MAIN_FIGURE=srp_experiment/results/paper_figure_pack/main_3panel_figure.png

# OpenAI backend
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local OpenAI-compatible backend
# If vLLM runs inside WSL/Ubuntu and localhost forwarding is unstable,
# replace this with the WSL IP, for example:
# LOCAL_MODEL_URL=http://172.25.253.78:8000
LOCAL_MODEL_URL=http://localhost:8000
